{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charliechandlernet",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  }
}
