{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charliechandlernet",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-22",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
